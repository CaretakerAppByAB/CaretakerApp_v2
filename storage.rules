rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Profile photos — public read (shown as avatars everywhere), only the
    // owning user may upload/replace their own.
    match /profilePhotos/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Community post / comment images — public, same as the posts/comments
    // themselves in Firestore. Any signed-in user may upload.
    match /postImages/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    match /commentImages/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Chat images — only the encrypted URL pointer is protected in Firestore
    // (see messagingService.ts); the file itself just requires sign-in.
    match /chatImages/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
